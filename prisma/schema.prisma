// Prisma schema for VetBra

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VET
  ADMIN
}

enum CrmvStatus {
  PENDENTE
  VERIFICADO
  EM_ANALISE
  SUSPENSO
  REJEITADO
}

enum PlanoTipo {
  BASICO
  PROFISSIONAL
  PREMIUM
}

enum AssinaturaStatus {
  ATIVO
  PENDENTE
  CANCELADO
  INADIMPLENTE
}

enum FaturaStatus {
  PENDENTE
  PAGO
  EXPIRADO
  CANCELADO
}

enum MetodoPagamento {
  PIX
  BOLETO
  CARTAO
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  login         String?      @unique
  senhaHash     String
  nome          String
  role          Role         @default(VET)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  veterinario   Veterinario?
}

model Veterinario {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  slug                  String            @unique
  nomeCompleto          String
  nomeSocialOuClinica   String?
  cpfCnpj               String?
  telefone              String?
  whatsapp              String
  bio                   String?
  tempoExperienciaAnos  Int?              @default(0)
  fotoPerfilUrl         String?
  bannerUrl             String?
  
  // CRMV & Validação Anti-Fraude
  crmvNumero            String
  crmvUf                String
  crmvStatus            CrmvStatus        @default(PENDENTE)
  crmvValidade          DateTime?
  crmvDocumentoUrl      String?           // Foto da carteira profissional CRMV
  crmvSelfieUrl         String?           // Foto segurando o documento (selfie anti-fraude)
  crmvComprovanteUrl    String?           // Comprovante complementar
  crmvAlerta30diasEnviado Boolean         @default(false)
  crmvUltimaVerificacao DateTime?
  crmvNotasAuditoria    String?
  
  // Tipo de Atendimento & Deslocamento
  tipoEstabelecimento   String            @default("Clinica") // Clinica, Consultorio, Hospital 24h, Atendimento Domiciliar / VetMóvel
  meioTransporte        String?           @default("Nenhum")  // Legado / compatibilidade
  meiosTransporte       String[]          @default([])        // CARRO_PETMOVEL, CARRO_AMBULANCIA, MOTO, FIXO
  raioAtendimentoKm     Int?              @default(15)        // 5, 15, 30 ou 99999 (Sem Limites)
  cidadeBase            String?           @default("São Paulo")
  estadoBase            String?           @default("SP")
  permiteVetMovelApp    Boolean           @default(false)     // Modo VetMóvel para futuro app de transporte pet
  atende24h             Boolean           @default(false)
  atendeDomiciliar      Boolean           @default(false)
  atendeEmergencia      Boolean           @default(false)
  horarioFuncionamento  String?           @default("Segunda a Sexta - 08:00 às 18:00")
  tiposPets             String[]          @default(["Cães", "Gatos"])
  
  // Redes Sociais
  instagram             String?
  facebook              String?
  site                  String?

  // Monetização / Plano
  plano                 PlanoTipo         @default(BASICO)
  statusAssinatura      AssinaturaStatus  @default(ATIVO)
  destaqueBusca         Boolean           @default(false)
  visualizacoesCount    Int               @default(0)
  contatosWhatsappCount Int               @default(0)

  // Relações
  enderecos             Endereco[]
  especialidades        Especialidade[]
  procedimentos         Procedimento[]
  avaliacoes            Avaliacao[]
  auditorias            CrmvAuditoriaLog[]
  artigos               Artigo[]
  cliquesWhatsapp       CliqueWhatsappLog[]
  faturas               FaturaCobranca[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model Endereco {
  id                String      @id @default(uuid())
  veterinarioId     String
  veterinario       Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  tipoEndereco      String      @default("PRINCIPAL") // PRINCIPAL, FILIAL
  cep               String
  logradouro        String
  numero            String
  complemento       String?
  bairro            String
  cidade            String
  estado            String      // SP, RJ, etc.
  latitude          Float?
  longitude         Float?
  raioKmAtendimento Int?        @default(15) // Para atendimento a domicílio

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Especialidade {
  id            String        @id @default(uuid())
  nome          String        @unique // Ex: Clínica Geral, Dermatologia, Ortopedia
  descricao     String?
  veterinarios  Veterinario[]

  createdAt     DateTime      @default(now())
}

model Procedimento {
  id                String      @id @default(uuid())
  veterinarioId     String
  veterinario       Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  nome              String      // Ex: Consulta Clínica Geral, Vacina V10, Castração
  categoria         String      // Consulta, Vacinação, Cirurgia, Exame, Emergência, Estética
  preco             Float       // Valor em R$
  precoSobConsulta  Boolean     @default(false)
  descricao         String?
  tempoMedioMinutos Int?

  ativo             Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Avaliacao {
  id            String      @id @default(uuid())
  veterinarioId String
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  nomeTutor     String
  nota          Int         // 1 a 5
  comentario    String
  createdAt     DateTime    @default(now())
}

model CrmvAuditoriaLog {
  id            String      @id @default(uuid())
  veterinarioId String
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  adminEmail    String
  statusAnterior CrmvStatus
  statusNovo    CrmvStatus
  motivo        String?
  createdAt     DateTime    @default(now())
}

model Artigo {
  id            String      @id @default(uuid())
  veterinarioId String
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)

  titulo        String
  slug          String      @unique
  resumo        String
  conteudo      String      @db.Text
  fotoUrl       String?
  categoria     String      @default("Clínica Geral")
  publicado     Boolean     @default(true)
  visualizacoes Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([veterinarioId])
  @@index([categoria])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  codigo    String   // Código numérico de 6 dígitos para WhatsApp/Email
  token     String   @unique
  expiraEm  DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([codigo])
}

model CliqueWhatsappLog {
  id            String      @id @default(uuid())
  veterinarioId String
  veterinario   Veterinario @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  origem        String      @default("PERFIL") // PERFIL, CARD_BUSCA, MAPA
  ip            String?
  userAgent     String?
  cidadeTutor   String?
  createdAt     DateTime    @default(now())

  @@index([veterinarioId])
  @@index([createdAt])
}

model BuscaLeadLog {
  id            String   @id @default(uuid())
  termo         String?
  cep           String?
  cidade        String?
  estado        String?
  tipoPet       String?
  especialidade String?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([cep])
  @@index([cidade, estado])
  @@index([createdAt])
}

model FaturaCobranca {
  id                   String          @id @default(uuid())
  veterinarioId        String
  veterinario          Veterinario     @relation(fields: [veterinarioId], references: [id], onDelete: Cascade)
  plano                PlanoTipo
  valor                Float
  status               FaturaStatus    @default(PENDENTE)
  metodo               MetodoPagamento @default(PIX)
  pixCopiaCola         String?
  pixQrCodeUrl         String?
  boletoCodigoBarras   String?
  boletoLinhaDigitavel String?
  boletoPdfUrl         String?
  dataVencimento       DateTime
  dataPagamento        DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([veterinarioId])
  @@index([status])
}
